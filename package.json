{
  "name": "fieras-de-la-arena",
  "private": true,
  "description": "Orquestación del repositorio: pruebas end-to-end con Playwright y atajos para client y server.",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "test:server": "npm test --prefix server",
    "test:server:unit": "npm run test:unit --prefix server",
    "test:client": "npm test --prefix client",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "check:mongo": "node server/scripts/checkMongoReplicaSet.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
